#. Description of the plugin
#: wc-victoriabank-mia.php
msgid ""
"Accept MIA payments directly on your store with the Payment Gateway for "
"Victoriabank MIA for WooCommerce."
msgstr ""
"Acceptă plăți MIA direct în magazin cu gateway-ul de plată Victoriabank MIA "
"pentru WooCommerce."

#: wc-victoriabank-mia.php:128
msgid "Enable/Disable"
msgstr "Activare/Dezactivare"

#: wc-victoriabank-mia.php:130
msgid "Enable this gateway"
msgstr "Activează acest gateway de plată"

#: wc-victoriabank-mia.php:134
msgid "Title"
msgstr "Titlu"

#: wc-victoriabank-mia.php:136
msgid "Payment method title that the customer will see during checkout."
msgstr "Titlul metodei de plată afișat clientului în timpul plății."

#: wc-victoriabank-mia.php:141
msgid "Description"
msgstr "Descriere"

#: wc-victoriabank-mia.php:143
msgid "Payment method description that the customer will see during checkout."
msgstr "Descrierea metodei de plată afișată clientului în timpul plății."

#: wc-victoriabank-mia.php:149
msgid "Test mode"
msgstr "Mod testare"

#: wc-victoriabank-mia.php:151
msgid "Enabled"
msgstr "Activat"

#: wc-victoriabank-mia.php:152
msgid ""
"Use Test or Live bank gateway to process the payments. Disable when ready to "
"accept live payments."
msgstr ""
"Conectare la mediul de Test sau Producție al băncii pentru procesarea "
"plăților. Dezactivați atunci când sunteți gata să acceptați plăți reale."

#: wc-victoriabank-mia.php:157
msgid "Debug mode"
msgstr "Mod depanare"

#: wc-victoriabank-mia.php:159
msgid "Enable logging"
msgstr "Activează jurnalizare"

#: wc-victoriabank-mia.php:161
msgid "View logs"
msgstr "Vizualizați jurnalele"

#: wc-victoriabank-mia.php:162
msgid ""
"Save debug messages to the WooCommerce System Status logs. Note: this may "
"log personal information. Use this for debugging purposes only and delete "
"the logs when finished."
msgstr ""
"Salvare mesaje de depanare în logurile de stare sistem ale WooCommerce. "
"Notă: acest lucru poate înregistra informații personale. Utilizați această "
"opțiune numai pentru depanare și ștergeți jurnalele atunci când ați terminat."

#: wc-victoriabank-mia.php:166
msgid "Order description"
msgstr "Descriere comandă"

#. translators: 1: Example placeholder shown to user, represents Order ID
#: wc-victoriabank-mia.php:169
#, php-format
msgid "Format: <code>%1$s</code> - Order ID"
msgstr "Format: <code>%1$s</code> - ID Comandă"

#: wc-victoriabank-mia.php:170
msgid "Order description that the customer will see on the bank payment page."
msgstr ""
"Descrierea comenzii afișată clientului pe pagina băncii în timpul plății."

#: wc-victoriabank-mia.php:174
msgid "Transaction validity"
msgstr "Valabilitatea tranzacției"

#: wc-victoriabank-mia.php:176
msgid "minutes"
msgstr "minute"

#: wc-victoriabank-mia.php:181 wc-victoriabank-mia.php:285
msgid "Connection Settings"
msgstr "Setări conexiune"

#: wc-victoriabank-mia.php:182
msgid "Payment gateway connection credentials are provided by the bank."
msgstr "Datele de conectare la gateway-ul de plată sunt furnizate de bancă."

#: wc-victoriabank-mia.php:186
msgid "Username"
msgstr "Nume utilizator"

#: wc-victoriabank-mia.php:190
msgid "Password"
msgstr "Parolă"

#: wc-victoriabank-mia.php:194
msgid "Certificate"
msgstr "Certificat"

#: wc-victoriabank-mia.php:196
msgid ""
"Victoriabank Public Key Certificate to validate the authenticity of the "
"payment notifications."
msgstr ""
"Certificatul de cheie publică al Victoriabank pentru validarea "
"autenticității notificărilor de plată."

#: wc-victoriabank-mia.php:200
msgid "Company Name"
msgstr "Nume companie"

#: wc-victoriabank-mia.php:204
msgid "Creditor Account"
msgstr "Cont creditor"

#: wc-victoriabank-mia.php:206
msgid "IBAN"
msgstr "IBAN"

#: wc-victoriabank-mia.php:210
msgid "Payment Notification"
msgstr "Notificare plăți"

#: wc-victoriabank-mia.php:213
msgid "Provide this URL to the bank to enable online payment notifications."
msgstr ""
"Furnizați băncii această adresă URL pentru activare notificări de plată "
"online."

#: wc-victoriabank-mia.php:214
msgid "Callback URL"
msgstr "URL apel invers (Callback URL)"

#: wc-victoriabank-mia.php:272
msgid "Unsupported store currency"
msgstr "Valuta magazinului nu este suportată"

#: wc-victoriabank-mia.php:274
msgid "Supported currencies"
msgstr "Valute suportate"

#. translators: 1: Plugin installation instructions URL
#: wc-victoriabank-mia.php:284
#, php-format
msgid ""
"See plugin documentation for <a href=\"%1$s\" target=\"_blank\">installation "
"instructions</a>."
msgstr ""
"Consultați documentația modulului pentru <a href=\"%1$s\" "
"target=\"_blank\">instrucțiuni de instalare</a>."

#: wc-victoriabank-mia.php:285
msgid "Not configured"
msgstr "Neconfigurat"

#. translators: 1: Payment method title, 2: Plugin settings URL
#: wc-victoriabank-mia.php:315
#, php-format
msgid ""
"%1$s is not properly configured. Verify plugin <a href=\"%2$s\">Connection "
"Settings</a>."
msgstr ""
"%1$s nu este configurat corect. Verificați <a href=\"%2$s\">Setările de "
"conexiune</a>."

#. translators: 1: Payment method title, 2: Plugin settings URL
#: wc-victoriabank-mia.php:322
#, php-format
msgid ""
"See <a href=\"%2$s\">%1$s settings</a> page for log details and setup "
"instructions."
msgstr ""
"Consultați pagina de <a href=\"%2$s\">setări %1$s</a> pentru vizualizarea "
"jurnalului și instrucțiuni de configurare."

#. translators: 1: Order ID, 2: Payment method title, 3: API response details
#: wc-victoriabank-mia.php:459
#, php-format
msgid "Order #%1$s payment initiated via %2$s: %3$s"
msgstr "Plata comenzii #%1$s inițiată prin %2$s: %3$s"

#. translators: 1: Order ID, 2: Payment method title
#: wc-victoriabank-mia.php:472
#, php-format
msgid "Order #%1$s payment initiation failed via %2$s."
msgstr "Inițierea plății comenzii #%1$s prin %2$s a eșuat."

#. translators: 1: Payment method title
#: wc-victoriabank-mia.php:496
#, php-format
msgid "%1$s Callback URL"
msgstr "%1$s Callback URL"

#. translators: 1: Payment notification callback body
#: wc-victoriabank-mia.php:506
#, php-format
msgid "Payment notification callback: %1$s"
msgstr "Notificare de plată: %1$s"

#. translators: 1: QR Extension ID, 2: Payment method title
#: wc-victoriabank-mia.php:535
#, php-format
msgid "Order not found by QR Extension ID: %1$s received from %2$s."
msgstr "Comanda nu a fost gasită după QR Extension ID: %1$s primit de la %2$s."

#. translators: 1: Callback notification price, 2: Order total price
#: wc-victoriabank-mia.php:557
#, php-format
msgid "Order amount mismatch: Callback: %1$s, Order: %2$s."
msgstr "Sumă comandă incorectă: Notificare: %1$s, Comandă: %2$s."

#. translators: 1: Order ID
#: wc-victoriabank-mia.php:565
#, php-format
msgid "Callback order already fully paid: %1$s."
msgstr "Comanda este deja plătită integral: %1$s."

#. translators: 1: Order ID, 2: Payment method title, 3: Payment notification callback data
#: wc-victoriabank-mia.php:584
#, php-format
msgid "Order #%1$s payment completed via %2$s: %3$s"
msgstr "Plata comenzii #%1$s finalizată prin %2$s: %3$s"

#. translators: 1: Payment method title
#: wc-victoriabank-mia.php:608
#, php-format
msgid "Partial refunds are not currently supported by %1$s."
msgstr "Rambursările parțiale nu sunt acceptate în prezent de %1$s."

#. translators: 1: Order ID, 2: Refund amount, 3: Payment method title, 4: Error message
#: wc-victoriabank-mia.php:634
#, php-format
msgid "Order #%1$s refund of %2$s via %3$s failed: %4$s"
msgstr "Rambursarea comenzii #%1$s în suma de %2$s prin %3$s a eșuat: %4$s"

#. translators: 1: Order ID, 2: Refund amount, 3: Payment method title
#: wc-victoriabank-mia.php:645
#, php-format
msgid "Order #%1$s refund of %2$s via %3$s approved."
msgstr "Rambursarea comenzii #%1$s suma de %2$s prin %3$s a fost aprobată."

#: wc-victoriabank-mia.php:664
msgid "This order has a pending payment. Follow the instructions below."
msgstr ""
"Această comandă are o plată în așteptare. Urmează instrucțiunile de mai jos."

#: wc-victoriabank-mia.php:685
msgid "This order is fully paid."
msgstr "Comanda este platită integral."

#. translators: 1: Order ID, 2: Meta field name
#: wc-victoriabank-mia.php:695
#, php-format
msgid "Order #%1$s missing meta field %2$s."
msgstr "Comanda #%1$s lipsește câmpul meta %2$s."

#: wc-victoriabank-mia.php:701
msgid "Select & Pay"
msgstr "Selectează & Plătește"

#: wc-victoriabank-mia.php:701
msgid "Scan & Pay"
msgstr "Scanează & Plătește"

#: wc-victoriabank-mia.php:702
msgid "Choose the financial app from the list by pressing the button below."
msgstr "Alege aplicația financiară din listă apăsând butonul de mai jos."

#: wc-victoriabank-mia.php:702
msgid ""
"Scan this QR code with your phone camera or from your financial app and "
"complete the payment."
msgstr ""
"Scanează acest QR cod cu camera telefonului sau din aplicația ta financiară "
"și finalizează plata."

#: wc-victoriabank-mia.php:703
msgid "Banks list"
msgstr "Lista băncilor"

#: wc-victoriabank-mia.php:746
msgid "Invalid request"
msgstr "Cerere nevalidă"

#: wc-victoriabank-mia.php:755
msgid "Order not found"
msgstr "Comanda nu a fost găsită"

