msgstr "В заказе #%1$s отсутствует мета-поле %2$s."

#. translators: 1: Order ID, 2: Payment method title, 3: Payment status
#: payment-gateway-wc-victoriabank-mia.php:793
#, php-format
msgid "Order #%1$s %2$s payment status: %3$s"
msgstr "Статус оплаты заказа #%1$s через %2$s: %3$s"

#. translators: 1: Order ID
#: payment-gateway-wc-victoriabank-mia.php:819
#, php-format
msgid "Order #%1$s payment check failed."
msgstr "Ошибка проверки оплаты заказа #%1$s."

#. translators: 1: Payment data price, 2: Order total price
#: payment-gateway-wc-victoriabank-mia.php:840
#, php-format
msgid "Order payment data mismatch: Payment: %1$s, Order: %2$s."
msgstr "Несоответствие платежных данных заказа: Оплата: %1$s, Заказ: %2$s."

#. translators: 1: Order ID
#: payment-gateway-wc-victoriabank-mia.php:848
#, php-format
msgid "Order #%1$s already fully paid."
msgstr "Заказ #%1$s уже полностью оплачен."

#. translators: 1: Order ID, 2: Payment method title, 3: Payment data
#: payment-gateway-wc-victoriabank-mia.php:867
#, php-format
